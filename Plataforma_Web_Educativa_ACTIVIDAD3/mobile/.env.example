# URL pública del backend en Render (sin / al final), p.ej.:
#   EXPO_PUBLIC_API_URL=https://educar-para-transformar.onrender.com
# Si se deja vacío, la app usa la IP de LAN hardcodeada en src/config.js
# (solo sirve para desarrollo local con Expo Go en la misma WiFi que el backend).
EXPO_PUBLIC_API_URL=

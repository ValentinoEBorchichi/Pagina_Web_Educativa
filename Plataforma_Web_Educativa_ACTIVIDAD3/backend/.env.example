# Puerto: en local 3000. En Render no lo definas: la plataforma inyecta PORT automáticamente.
PORT=3000

# Secreto para firmar los JWT (obligatorio: el servidor no arranca sin él).
# Generá uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo

# --- Base de datos: PostgreSQL en Supabase (src/config/db.js) ---
# Connection string completa. En Supabase: Project Settings -> Database ->
# Connection string -> URI (usá el "Session pooler" si el host, como Render,
# no soporta IPv6 directo). Nunca se comparte en el chat ni se sube al repo.
#   postgresql://postgres.xxxx:TU_PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://usuario:password@host:puerto/postgres
# Dejar sin definir (el TLS de Supabase se valida normalmente). Solo poner
# DATABASE_SSL_INSECURE=true si estás detrás de un proxy/VPN que reemplaza el
# certificado y te da error de conexión -nunca activarlo en producción-.
# DATABASE_SSL_INSECURE=false

# --- Supabase Storage (comprobantes y facturas: src/config/supabaseStorage.js) ---
# Project Settings -> API, en el mismo proyecto de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "service_role" key (NO la "anon"/pública): acceso total a Storage desde el
# backend. Nunca se expone al frontend/mobile ni se comparte en el chat.
SUPABASE_SERVICE_ROLE_KEY=cambia-esto-por-la-service-role-key

# Nombres de los buckets (privados) en Supabase Storage. Si no existen todavía,
# creálos en Storage -> New bucket, con "Public bucket" desactivado.
SUPABASE_BUCKET_COMPROBANTES=comprobantes
SUPABASE_BUCKET_FACTURAS=facturas

# Gmail SMTP: usar una Contraseña de Aplicación, no la contraseña normal.
EMAIL_USER=cuenta-institucional@gmail.com
EMAIL_PASS=contraseña-de-aplicacion-de-16-caracteres

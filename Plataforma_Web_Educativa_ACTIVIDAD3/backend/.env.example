# Puerto: en local 3000. En Railway NO lo definas, Railway inyecta PORT automáticamente.
PORT=3000

# Ruta de la base SQLite: solo la usan los módulos legados que todavía no
# migraron a SQL Server. En local déjalo así (relativo a la carpeta backend).
# En Railway, monta un Volume en /data y define: DATABASE_PATH=/data/database.sqlite
DATABASE_PATH=./database/database.sqlite

# Secreto para firmar los JWT (obligatorio: el servidor no arranca sin él).
# Generá uno aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo

# --- Microsoft SQL Server (src/config/db.js) ---
DB_SERVER=localhost
# Puerto TCP. Si usás una instancia con nombre (p. ej. SQLEXPRESS), comentá
# DB_PORT y definí DB_INSTANCE=SQLEXPRESS (requiere el servicio SQL Browser).
DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS
DB_NAME=EducarParaTransformar
# Login de SQL Server (autenticación SQL, no Windows).
DB_USER=ept_app
DB_PASSWORD=cambia-esta-clave
DB_ENCRYPT=true
# true solo en local (certificado autofirmado). En producción: false.
DB_TRUST_SERVER_CERTIFICATE=true

# URL del backend.
# En local no hace falta (usa http://localhost:3000 por defecto).
# En Railway define esta variable en el servicio FRONTEND con la URL pública del backend.
# IMPORTANTE: Vite incrusta esta variable en tiempo de BUILD, así que debe estar
# definida antes/durante el build (Railway la pasa automáticamente al build).
VITE_API_URL=https://tu-backend.up.railway.app
